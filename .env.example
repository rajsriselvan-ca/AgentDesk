# ---------------------------------------------------------------------------
# AgentDesk environment
# Copy to .env and adjust. Every value below has a working default for local
# development except DATABASE_URL, which must point at a real Postgres.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentdesk

# API server port.
PORT=3001

# Origin allowed to call the API (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# AI provider
#
#   mock      Deterministic in-process model. No API key, no network, no cost.
#             Routing and tool selection are rule-based but exercise the exact
#             same agent, tool, and streaming code paths as a real model.
#   anthropic Real Claude calls through the Vercel AI SDK. Requires a key.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock

# Only read when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Model used by the router and the sub-agents.
AGENT_MODEL=claude-opus-5

# Smaller model used only to compact old conversation history.
COMPACTION_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------

# Sliding-window rate limits: requests per window per user+IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_CHAT_MAX=15

# Conversation context budget, in estimated tokens. Older history is folded
# into a rolling summary once the assembled context exceeds this.
CONTEXT_TOKEN_BUDGET=6000

# Messages always kept verbatim at the tail of the context, never summarized.
CONTEXT_RECENT_MESSAGES=10

# Hard ceiling on tool-calling steps within a single agent turn.
AGENT_MAX_STEPS=6

# Per-tool execution timeout in milliseconds.
TOOL_TIMEOUT_MS=5000
